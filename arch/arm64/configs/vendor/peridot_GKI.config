# Charger
CONFIG_MI_DTPT=y
CONFIG_MI_ENABLE_DP=y

# Debug
CONFIG_MI_DUMP_DISPLAY=m
CONFIG_MTD=m
CONFIG_MTD_BLOCK=m
CONFIG_MTD_BLOCK2MTD=m
CONFIG_MTD_OOPS=m
CONFIG_QCOM_DYN_MINIDUMP_STACK=y
CONFIG_REGMAP_QTI_DEBUGFS_ALLOW_WRITE=y
CONFIG_XLOGCHAR=m

# Fingerprint
CONFIG_FINGERPRINT_MI_FP=m
CONFIG_INPUT_FINGERPRINT=y

# HWID
CONFIG_MI_HARDWARE_ID=m

# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y

# Joystick
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y

# Net
CONFIG_NETFILTER_XT_MATCH_CONNBYTES=y

# Regulators
CONFIG_REGULATOR_WL2866D=m

# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
CONFIG_MI_THERMAL_MULTI_CHARGE=y

# Vibrator
# CONFIG_LEDS_QPNP_VIBRATOR_LDO is not set
CONFIG_INPUT_AW86927_HAPTIC=m
CONFIG_SIH_VIBRATOR=m

# === Custom Boost configs (mjdevf) ===
CONFIG_SCHED_WALT=y
CONFIG_SCHED_WALT_DEBUG=m
CONFIG_SCHED_CONSERVATIVE_BOOST_LPM_BIAS=y

# UClamp - auto frequency boosting based on load
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=20

# Better CPU idle for SM8635
CONFIG_CPU_IDLE_GOV_TEO=y
CONFIG_CPU_IDLE_GOV_LADDER=y

# Better I/O
CONFIG_MQ_IOSCHED_BFQ=y
CONFIG_BLK_CGROUP_IOCOST=y

# ZRAM optimization
CONFIG_ZRAM_DEF_COMP="zstd"
CONFIG_CRYPTO_XXHASH=y

# TCP optimizations
CONFIG_TCP_CONG_BBR=y
CONFIG_NET_SCH_FQ_CODEL=y

# Memory
CONFIG_ZSWAP=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y

# BPF for profiling
CONFIG_BPF_JIT_ALWAYS_ON=y
